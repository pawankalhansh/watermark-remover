# Free browser mode does not need an OpenAI key.
# These values are only for the optional paid cloud repair endpoint.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=auto
PORT=8765
# Only for local testing when office/corporate SSL inspection causes SELF_SIGNED_CERT_IN_CHAIN.
OPENAI_ALLOW_INSECURE_TLS=false
